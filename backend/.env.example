# Environment & Networking
NODE_ENV=production
PORT=5000
CORS_ORIGIN=*

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YOUR_STRONG_PASSWORD
DB_NAME=smartcity
DB_PORT=3306

# Secret token for external ambulance GPS telemetry updates
AMBULANCE_UPDATE_TOKEN=your_secure_ambulance_token_2026

# JWT Authentication & RBAC
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d
REQUIRE_AUTH=true

# Google Gemini API Integration (Optional - native NLP fallback works offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Autonomous Simulator Control
SIMULATE_AMBULANCES=true

# Security & Rate Limiting
DISABLE_RATE_LIMIT=false

