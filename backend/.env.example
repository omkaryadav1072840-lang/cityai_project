# ========================================================
# SmartCity AI - Environment Configuration Example
# Copy to .env and populate with production values.
# NEVER commit the actual .env file with secrets to Git.
# ========================================================

# Environment & Networking
NODE_ENV=production
PORT=5000
CORS_ORIGIN=*

# MySQL Database Configuration (Supports DB_* and MYSQL_* prefixes)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD
DB_NAME=smartcity
DB_PORT=3306

# Secret token for external ambulance GPS telemetry updates
AMBULANCE_UPDATE_TOKEN=your_secure_ambulance_token_2026

# JWT Authentication & RBAC
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d
REQUIRE_AUTH=true

# Google Gemini / LLM Integration (Native NLP fallback operates if key is empty)
LLM_PROVIDER=google_gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=7500
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=800

# Autonomous Ambulance Simulator Control
SIMULATE_AMBULANCES=true

# Security & Rate Limiting
DISABLE_RATE_LIMIT=false

# Privacy-Preserving Telemetry & Analytics
ANALYTICS_ENABLED=true

# Demo Persona Login (Set to false in strict production environments)
ALLOW_DEMO_LOGIN=true

# ========================================================
# Free Email OTP Delivery Configuration (Nodemailer SMTP)
# ========================================================
# Option 1 (Development): Leave empty. OTPs will be securely logged to server console (DEV-ONLY).
# Option 2 (Gmail SMTP Free Tier): 500 emails/day. Use 16-character App Password (not your Google account password).
# Option 3 (Brevo / Sendinblue): 300 emails/day free tier. Host: smtp-relay.brevo.com, Port: 587.
# Option 4 (Mailtrap Sandbox): Safe testing environment for staging.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SmartCity AI Gorakhpur
SMTP_FROM_ADDR=noreply@smartcity.gorakhpur.gov.in

# ========================================================
# Python AI / FastAPI ML Service Gateway
# ========================================================
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_KEY=smartcity_ai_internal_token_gorakhpur_2026
