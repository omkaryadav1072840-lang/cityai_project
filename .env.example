# ====================================================================
# SMARTCITY AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Platform: Gorakhpur Smart City Management Platform
# ====================================================================

# Port for Express.js Application Gateway
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=smartcity_db

# JWT & Authentication Secret
JWT_SECRET=smartcity_super_secret_jwt_key_gorakhpur_2026

# AI / ML Microservice Gateway (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000
PYTHON_AI_ENABLED=true

# Optional Multimodal Generative AI (Gemini 2.5 / 1.5 Pro)
# If omitted or empty, the platform seamlessly operates using the local Grounded Municipal Intent Engine
GEMINI_API_KEY=

# City Location Defaults
DEFAULT_LATITUDE=26.7606
DEFAULT_LONGITUDE=83.3732
CITY_NAME="Gorakhpur"
STATE_NAME="Uttar Pradesh"
