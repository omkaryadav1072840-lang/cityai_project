{
  "name": "smartcity-ai",
  "version": "2.0.0",
  "description": "SmartCity AI - Multi-Department Intelligent Smart City Management Platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node scripts/dev.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "node scripts/serve_frontend.js",
    "test": "node scratch/test_master_backend_routes.js",
    "test:all": "node scripts/run_all_tests.js",
    "test:py": "python -m pytest ai_service/tests",
    "docker:up": "docker compose up --build",
    "docker:dev": "docker compose up",
    "docker:down": "docker compose down",
    "docker:test": "docker compose exec backend npm test",
    "init-db": "node backend/database/init_db.js",
    "mobile:sync": "cap sync android",
    "mobile:copy": "cap copy android",
    "mobile:open": "cap open android",
    "mobile:build": "cap sync android",
    "build:apk": "node -e \"require('child_process').execSync('npx cap sync android', {stdio: 'inherit'})\"",
    "open:android": "cap open android"
  },
  "keywords": [
    "smartcity",
    "iot",
    "ai",
    "gorakhpur",
    "docker",
    "fastapi",
    "express"
  ],
  "author": "SmartCity AI Team",
  "license": "ISC",
  "dependencies": {
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  }
}
